{
  "name": "nice-fns",
  "type": "module",
  "version": "2.0.0",
  "description": "A modern and nice library of JS functions.",
  "author": "RayHao <https://github.com/l246804>",
  "license": "MIT",
  "homepage": "https://l246804.github.io/nice-fns/",
  "repository": {
    "type": "git",
    "url": "https://github.com/l246804/nice-fns"
  },
  "bugs": {
    "url": "https://github.com/l246804/nice-fns/issues"
  },
  "keywords": [
    "web",
    "node",
    "lodash",
    "function",
    "tool",
    "utils"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": "./*"
  },
  "sideEffect": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "run-s gen:index build:only rm:index",
    "build:only": "rslib build",
    "gen:index": "node scripts/genIndex.mjs",
    "rm:index": "node scripts/rmIndex.mjs",
    "release": "release-it",
    "cz": "cz",
    "plop": "plop",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:only": "vitest run",
    "test:ui": "vitest --ui",
    "test:cover": "vitest run --coverage",
    "docs:dev": "npm run docs:prepare && vitepress dev docs",
    "docs:build": "npm run docs:prepare && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:gen": "typedoc --options typedoc.mjs",
    "docs:gen:lib": "npm run gen:index -- -D",
    "docs:clean": "rimraf docs/api",
    "docs:prepare": "run-s docs:clean test:only docs:gen docs:gen:lib",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "es-toolkit": "^1.33.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2",
    "@microsoft/api-extractor": "^7.52.1",
    "@release-it/conventional-changelog": "^7",
    "@rhao/plop-generators": "^1.2.3",
    "@rslib/core": "^0.5.4",
    "@types/fs-extra": "^11.0.4",
    "@vitest/coverage-v8": "^0.34.6",
    "@vitest/ui": "^0.34.6",
    "commitizen": "^4",
    "eslint": "^8",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.1.1",
    "git-cz": "^4",
    "lint-staged": "^15.5.0",
    "npm-run-all": "^4.1.5",
    "plop": "latest",
    "prettier": "^3",
    "release-it": "^16.2.1",
    "rimraf": "^5.0.5",
    "typedoc": "^0.25.4",
    "typedoc-plugin-markdown": "4.0.0-next.34",
    "typedoc-vitepress-theme": "1.0.0-next.3",
    "typescript": "^5.8.2",
    "unplugin-auto-import": "^0.17.1",
    "vitepress": "1.0.0-rc.31",
    "vitest": "^0.34.6"
  }
}
