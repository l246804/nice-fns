{
  "name": "nice-fns",
  "type": "module",
  "version": "2.1.0",
  "description": "A modern and nice library of JS functions.",
  "author": "RayHao <https://github.com/l246804>",
  "license": "MIT",
  "homepage": "https://l246804.github.io/nice-fns/",
  "repository": {
    "type": "git",
    "url": "https://github.com/l246804/nice-fns"
  },
  "bugs": {
    "url": "https://github.com/l246804/nice-fns/issues"
  },
  "keywords": [
    "web",
    "node",
    "lodash",
    "es-toolkit",
    "function",
    "tool",
    "utils"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js"
    },
    "./*": "./*"
  },
  "sideEffect": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "run-s test:only gen:index build:only rm:index",
    "build:only": "tsdown",
    "release": "release-it",
    "cz": "cz",
    "plop": "plop",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:only": "vitest run",
    "test:ui": "vitest --ui",
    "test:cover": "vitest run --coverage",
    "docs:dev": "npm run docs:prepare && vitepress dev docs",
    "docs:build": "npm run docs:prepare && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:gen": "typedoc --options typedoc.mjs",
    "docs:clean": "rimraf docs/api",
    "docs:prepare": "run-s docs:clean test:only docs:gen",
    "lint:fix": "eslint . --fix",
    "taze": "taze -iI major",
    "gen:index": "unindex",
    "rm:index": "rimraf ./src/index.ts"
  },
  "dependencies": {
    "es-toolkit": "^1.33.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.10.1",
    "@release-it/conventional-changelog": "^10.0.0",
    "@vitest/coverage-v8": "^3.0.9",
    "@vitest/ui": "^3.0.9",
    "commitizen": "^4.3.1",
    "eslint": "^9.22.0",
    "git-cz": "^4.9.0",
    "lint-staged": "^15.5.0",
    "npm-run-all2": "^8.0.1",
    "prettier": "^3.5.3",
    "release-it": "^18.1.2",
    "rimraf": "^5.0.10",
    "simple-git-hooks": "^2.13.0",
    "taze": "^19.0.2",
    "tsdown": "^0.11.9",
    "typedoc": "^0.28.1",
    "typedoc-plugin-markdown": "4.5.2",
    "typedoc-vitepress-theme": "1.1.2",
    "typescript": "^5.8.2",
    "unindex": "^0.2.2",
    "unplugin-auto-import": "^19.1.1",
    "vitepress": "1.0.0-rc.31",
    "vitest": "^3.0.9"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  }
}
